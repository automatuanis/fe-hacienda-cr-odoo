<odoo>
    <!-- Tree view for invoice lines -->
    <record id="remake_xml_line_view_tree" model="ir.ui.view">
        <field name="name">eicr.remake_xml.line.tree</field>
        <field name="model">eicr.remake_xml.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="invoice_number"/>
                <field name="state_tributacion"/>
                <field name="respuesta_tributacion"/>
                <field name="can_process"/>
            </tree>
        </field>
    </record>

    <!-- Multi-invoice form view -->
    <record id="remake_xml_view_wizard_form_multi" model="ir.ui.view">
        <field name="name">eicr.remake_xml.form.multi</field>
        <field name="model">eicr.remake_xml</field>
        <field name="arch" type="xml">
            <form string="Regenerar XML - Múltiples Facturas">
                <group>
                    <group>
                        <label string="Facturas Seleccionadas" colspan="2"/>
                        <div class="oe_left oe_edit_only">
                            <field name="invoice_count" class="oe_inline"/> seleccionadas
                        </div>
                        <div class="oe_left oe_edit_only">
                            <field name="processable_count" class="oe_inline"/> procesables
                        </div>
                        <div class="oe_left oe_edit_only" attrs="{'invisible': [('blocked_count', '=', 0)]}">
                            <field name="blocked_count" class="oe_inline"/> bloqueadas (aceptadas)
                        </div>
                    </group>
                    <group>
                        <field name="keep_clave"/>
                        <field name="keep_date"/>
                        <field name="new_date" attrs="{'invisible': [('keep_date', '=', True)], 'required': [('keep_date', '=', False)]}"/>
                    </group>
                </group>
                <notebook>
                    <page string="Facturas">
                        <field name="invoice_ids" invisible="1"/>
                        <field name="invoice_line_ids" nolabel="1">
                            <tree>
                                <field name="invoice_number"/>
                                <field name="state_tributacion"/>
                                <field name="respuesta_tributacion"/>
                                <field name="can_process"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <div class="alert alert-warning" role="alert" attrs="{'invisible': [('blocked_count', '=', 0)]}">
                    <strong>Atención:</strong> Las facturas en estado "aceptado" no pueden ser reprocesadas y serán omitidas.
                </div>
                <footer>
                    <button name="action_remake_xml_confirm" string="Regenerar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Single invoice form view (backward compatibility) -->
    <record id="remake_xml_view_wizard_form" model="ir.ui.view">
        <field name="name">eicr.remake_xml.form</field>
        <field name="model">eicr.remake_xml</field>
        <field name="arch" type="xml">
            <form string="Regenerar XML">
                <group>
                    <field name="invoice_id" invisible="1"/>
                    <field name="invoice_ids" invisible="1"/>
                    <field name="invoice_line_ids" invisible="1"/>
                    <field name="keep_clave"/>
                    <field name="keep_date"/>
                    <field name="new_date" attrs="{'invisible': [('keep_date', '=', True)], 'required': [('keep_date', '=', False)]}"/>
                    <separator string="Valores Actuales" colspan="2"/>
                    <field name="eicr_mensaje_hacienda" readonly="1"/>
                    <field name="eicr_date" readonly="1"/>
                    <field name="eicr_clave" readonly="1"/>
                </group>
                <footer>
                    <button name="action_remake_xml_confirm" string="Regenerar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
