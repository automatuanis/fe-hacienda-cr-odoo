<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

		<record id="view_discount_type_form" model="ir.ui.view">
			<field name="name">discount.type.form</field>
			<field name="model">discount.type</field>
			<field name="arch" type="xml">
				<form string="Tipos de descuento">
					<sheet string="Tipos de descuento">
						<group col="4">
							<field name="name"/>
							<field name="sequence"/>
						</group>
						<group col="4">
							<field name="active"/>
							<field name="notes"/>
						</group>
					</sheet>
				</form>
			</field>
		</record>

		<record id="view_discount_type_tree" model="ir.ui.view">
			<field name="name">discount.type.tree</field>
			<field name="model">discount.type</field>
			<field name="arch" type="xml">
				<tree string="Tipos de descuento">
					<field name="sequence"/>
					<field name="name"/>
					<field name="active"/>
				</tree>
			</field>
		</record>

		<record id="action_discount_type" model="ir.actions.act_window">
			<field name="name">Tipos de descuento</field>
			<field name="res_model">discount.type</field>
			<field name="view_type">form</field>
			<field name="view_mode">tree,form</field>
		</record>

		<menuitem id="menu_discount_type" name="Tipo de descuento" parent="menu_electronic_invoice"
				  sequence="10" action="action_discount_type"/>


	</data>
</odoo>
