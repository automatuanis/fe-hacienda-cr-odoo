<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_exoneration_issuer_form" model="ir.ui.view">
        <field name="name">exoneration_issuer.form</field>
        <field name="model">eicr.exoneration_issuer</field>
        <field name="arch" type="xml">
            <form string="Emisor de la Exoneración">
                <sheet string="Emisor de la Exoneración">
                    <group col="4">
                      <field name="name"/>
                      <field name="code"/>
                    </group >
                    <group col="4">
                      <field name="active"/>
                      <field name="notes"/>
                    </group >
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exoneration_issuer_tree" model="ir.ui.view">
        <field name="name">exoneration_issuer.tree</field>
        <field name="model">eicr.exoneration_issuer</field>
        <field name="arch" type="xml">
            <tree string="Emisores de la Exoneración">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <record id="action_exoneration_issuer" model="ir.actions.act_window">
        <field name="name">Emisores de la Exoneración</field>
        <field name="res_model">eicr.exoneration_issuer</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_exoneration_issuer" name="Emisores de Exoneración" parent="menu_electronic_invoice" sequence="10" action="action_exoneration_issuer"/>
    
</data></odoo>